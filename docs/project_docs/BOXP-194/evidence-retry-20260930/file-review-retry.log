SNAP=pre-upgrade-20260930T041850.db
COPY=/var/lib/etcd/BOXP-194-20260930T041153Z-restore-check.db
RESTORE=/var/lib/etcd/BOXP-194-20260930T041153Z-isolated-restore
sudo -n test ! -e "$COPY"
sudo -n test ! -e "$RESTORE"
STORE=$("${K[@]}" -n etcd-snapshots get pod -l app.kubernetes.io/name=etcd-snapshot-store -o jsonpath='{.items[0].metadata.name}')
