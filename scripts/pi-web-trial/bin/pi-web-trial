#!/usr/bin/env bash
# BOXP-714: Pi Web (tg-prplx/pi-web-agent) trial launcher for codex-workspace.
#
#   pi-web-trial install <built-pi-web-agent-dir>   copy the built app + trial Pi config
#   pi-web-trial start | stop | restart | status
#
# The server binds to 127.0.0.1 only. Open it through an SSH local port forward:
#   ssh -L 4317:127.0.0.1:4317 <codex-workspace>  ->  http://127.0.0.1:4317
#
# Pi runs with a dedicated agent dir (local llama-server model only, guard
# extension) and an environment without cloud API keys, so no cloud model is
# selectable and the existing ~/.pi/agent configuration is not touched.
set -euo pipefail

ROOT="${PI_WEB_TRIAL_ROOT:-$HOME/.local/share/pi-web-trial}"
VAULT="${PI_WEB_TRIAL_VAULT:-$HOME/Documents/obsidian-headless/BOXP}"
SANDBOX="$VAULT/Projects/pi-web-agent-trial/sandbox"
PORT="${PI_WEB_TRIAL_PORT:-4317}"
SESSION="pi-web-trial"
# Dedicated tmux socket so the trial never shares a server with the Owner's own tmux.
TMUX_CMD=(tmux -L pi-web-trial)
SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

install_trial() {
  local built="${1:?usage: pi-web-trial install <built-pi-web-agent-dir>}"
  if [[ ! -f "$built/packages/web/dist/server/cli.js" ]]; then
    echo "not a built pi-web-agent checkout: $built" >&2
    exit 1
  fi
  mkdir -p "$ROOT/app" "$ROOT/agent/extensions/pi-web-trial" "$ROOT/web" "$ROOT/logs" "$ROOT/bin"
  rm -rf "$ROOT/app"
  mkdir -p "$ROOT/app"
  (cd "$built" && tar --exclude=./.git -cf - .) | tar -C "$ROOT/app" -xf -
  install -m 0644 "$SRC_DIR/agent/models.json" "$SRC_DIR/agent/settings.json" "$SRC_DIR/agent/AGENTS.md" "$ROOT/agent/"
  install -m 0644 "$SRC_DIR/extension/index.ts" "$SRC_DIR/extension/guard.ts" "$ROOT/agent/extensions/pi-web-trial/"
  install -m 0755 "$SRC_DIR/bin/pi-web-trial" "$ROOT/bin/pi-web-trial"
  # fd is used by the find tool; reuse the binary Pi already downloaded (offline mode cannot fetch it).
  if [[ -x "$HOME/.pi/agent/bin/fd" ]]; then
    mkdir -p "$ROOT/agent/bin"
    install -m 0755 "$HOME/.pi/agent/bin/fd" "$ROOT/agent/bin/fd"
  fi
  mkdir -p "$SANDBOX"
  echo "installed to $ROOT"
}

server_command() {
  local node
  node="$(command -v node)"
  # Only non-secret variables are passed; cloud API keys and tokens are dropped.
  printf '%q ' env -i \
    "HOME=$HOME" "USER=${USER:-boxp}" "PATH=$ROOT/agent/bin:/usr/local/bin:/usr/bin:/bin" \
    "LANG=${LANG:-C.UTF-8}" "TERM=xterm-256color" "TZ=${TZ:-Asia/Tokyo}" \
    "PI_CODING_AGENT_DIR=$ROOT/agent" "PI_WEB_AGENT_DIR=$ROOT/web" \
    "PI_WEB_TRIAL_VAULT=$VAULT" "PI_WEB_TRIAL_SANDBOX=$SANDBOX" \
    "PI_SKIP_VERSION_CHECK=1" "PI_OFFLINE=1" \
    "$node" "$ROOT/app/packages/web/dist/server/cli.js" --host 127.0.0.1 --port "$PORT" --cwd "$VAULT"
}

health() {
  curl -fsS -m 5 "http://127.0.0.1:$PORT/api/health"
}

start_trial() {
  if "${TMUX_CMD[@]}" has-session -t "$SESSION" 2>/dev/null; then
    echo "already running (tmux session $SESSION)"
    return 0
  fi
  [[ -f "$ROOT/app/packages/web/dist/server/cli.js" ]] || {
    echo "not installed: run install first" >&2
    exit 1
  }
  local cmd
  cmd="$(server_command)"
  "${TMUX_CMD[@]}" new-session -d -s "$SESSION" "$cmd >> $(printf '%q' "$ROOT/logs/server.log") 2>&1"
  for _ in $(seq 1 20); do
    if health >/dev/null 2>&1; then
      echo "running: http://127.0.0.1:$PORT (tmux session $SESSION)"
      return 0
    fi
    sleep 0.5
  done
  echo "server did not become healthy; see $ROOT/logs/server.log" >&2
  exit 1
}

stop_trial() {
  if "${TMUX_CMD[@]}" has-session -t "$SESSION" 2>/dev/null; then
    "${TMUX_CMD[@]}" kill-session -t "$SESSION"
    echo "stopped"
  else
    echo "not running"
  fi
}

case "${1:-}" in
  install)
    shift
    install_trial "$@"
    ;;
  start) start_trial ;;
  stop) stop_trial ;;
  restart)
    stop_trial
    start_trial
    ;;
  status)
    if health; then echo; else
      echo "not running"
      exit 1
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
