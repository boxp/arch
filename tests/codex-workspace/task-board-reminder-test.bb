#!/usr/bin/env bb
(load-file (str (System/getenv "EVENTS")))
(in-ns 'task-board-events)
(def event {:event-id "BOXP-1-example-done" :ticket-id "BOXP-1"})
(def state (atom nil))
(def calls (atom []))
(def copy (atom {:primary "home" :text "秘密の本文"}))
(def status-result (atom {"exists" true "read" false "handled" false "replied" false}))
(def quiet (atom false))
(def url (atom "http://example.invalid/reminder"))
(defn check [label condition]
  (when-not condition (throw (ex-info label {})))
  (println (str "PASS: " label)))
(with-redefs [delivered-copy (fn [& _] @copy)
              read-home-state (fn [& _] @state)
              write-event! (fn [_ value] (reset! state value))
              reminder-url (fn [] @url)
              home-status (fn [_] @status-result)
              quiet-now? (fn [] @quiet)
              copy-age-seconds (fn [& _] 2000)
              seconds-since (fn [& _] 2000)
              home-payload (fn [& _] {:title "題名"})
              webhook-secret (fn [] "fixture-secret")
              http/post (fn [_ opts] (swap! calls conj (json/parse-string (:body opts) true)) {:status 202})]
  (reset! state {:event-id "BOXP-1-example-done.report" :status :sent :home-status "stored" :sent-at "t"})
  (reset! copy {:text "本文"})
  (flush-home-reminder! event)
  (check "primary なしは催促しない" (empty? @calls))
  (reset! copy {:primary "home" :text "秘密の本文"})
  (reset! quiet true)
  (flush-home-reminder! event)
  (check "静音中は持ち越す" (empty? @calls))
  (reset! quiet false)
  (flush-home-reminder! event)
  (flush-home-reminder! event)
  (check "未読は短い催促を一度だけ送る" (and (= 1 (count @calls)) (= "reminder" (:kind (first @calls))) (not (str/includes? (:text (first @calls)) "秘密"))))
  (reset! calls [])
  (reset! state {:event-id "BOXP-1-example-done.report" :status :sent :home-status "stored" :sent-at "t"})
  (reset! status-result {"exists" true "read" true "handled" false "replied" false})
  (flush-home-reminder! event)
  (check "既読なら催促しない" (and (empty? @calls) (= :unneeded (:reminder-status @state))))
  (reset! state {:event-id "BOXP-1-example-done.report" :status :failed})
  (flush-home-reminder! event)
  (flush-home-reminder! event)
  (check "転送失敗は全文を一度だけ fallback" (and (= 1 (count @calls)) (= "fallback" (:kind (first @calls))) (str/includes? (:text (first @calls)) "秘密の本文")))
  (reset! calls [])
  (reset! state {:event-id "BOXP-1-example-done.report" :status :sent :home-status "stored" :sent-at "t"})
  (reset! status-result nil)
  (flush-home-reminder! event)
  (check "状態取得失敗は次回再試行" (and (empty? @calls) (= 1 (:reminder-check-attempts @state))))
  (reset! state {:event-id "BOXP-1-example-done.report" :status :retry})
  (flush-home-reminder! event)
  (check "期限超過は fallback" (= "fallback" (:kind (first @calls))))
  (reset! calls [])
  (reset! state {:event-id "BOXP-1-example-done.report" :status :failed})
  (reset! url nil)
  (flush-home-reminder! event)
  (check "URL 未設定なら無効" (empty? @calls))
  (reset! url "http://example.invalid/reminder")
  (reset! state nil)
  (with-redefs [copy-age-seconds (fn [& _] (* 25 3600))]
    (flush-home-reminder! event))
  (check "状態が無い古い通知へは再送しない" (empty? @calls)))
