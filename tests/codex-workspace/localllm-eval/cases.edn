           :must-not-contain {"Projects/task-board-localllm-docs/pilot/glossary.md" ["ヘルスチェク "]}
           :unchanged-sections {"Projects/task-board-localllm-docs/pilot/glossary.md" ["## 例 / Example" "## 関連 / Related"]}
