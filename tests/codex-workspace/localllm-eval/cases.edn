;; BOXP-277 evaluation cases. Each case is a Task Board ticket against the
;; fixture vault (fixture.bb). Pass criteria are deterministic checks evaluated
;; by run_eval.bb; a human / independent model reads every output as well.
;;
;; :expect keys
;;   :stop?              true when the correct outcome is to make no change and
;;                       stop for a human (needs-human / blocked)
;;   :allowed-changes    vault-relative files that may differ after the run
;;   :must-contain       {path [regex ...]} after the run
;;   :must-not-contain   {path [regex ...]} after the run
;;   :unchanged-sections {path ["## heading" ...]} sections that must be identical
;;   :numbers-from       [path ...] digits appearing in the target's new text must
;;                       also appear in these sources or the ticket (hallucination guard)
[{:id "C01" :title "限定段落差替え（現状節の更新）" :group "edit"
  :targets ["Projects/task-board-localllm-docs/pilot/runbook.md"]
  :ticket {:title "runbook の現状節を v1.3 へ更新"
           :summary "`Projects/task-board-localllm-docs/pilot/runbook.md` の「## 現状」節だけを最新状態に更新する。"
           :acceptance ["現状節に稼働バージョン v1.3 と待受ポート 8081 が反映されている" "他の節・frontmatter・リンクは変更しない"]
           :context ["2026-10-20 に sample-stream を v1.3 へ更新し、待受ポートを 8080 から 8081 に変更した。ヘルスチェック間隔は 30 秒のまま。"]
           :notes []}
  :expect {:allowed-changes ["Projects/task-board-localllm-docs/pilot/runbook.md"]
           :must-contain {"Projects/task-board-localllm-docs/pilot/runbook.md" ["v1\\.3" "8081" "30 ?秒" "sample-dashboard"]}
           :must-not-contain {"Projects/task-board-localllm-docs/pilot/runbook.md" ["v1\\.2"]}
           :unchanged-sections {"Projects/task-board-localllm-docs/pilot/runbook.md" ["## 概要" "## 手順" "## 注意"]}
           :numbers-from []}}

 {:id "C02" :title "節の追記（週次メモに新しい日付の節）" :group "edit"
  :targets ["Projects/task-board-localllm-docs/pilot/weekly.md"]
  :ticket {:title "週次メモに 2026-10-23 の節を追記"
           :summary "`Projects/task-board-localllm-docs/pilot/weekly.md` の末尾に「## 2026-10-23」節を追加し、Notes の 3 項目を箇条書きで記録する。既存の節は変更しない。"
           :acceptance ["## 2026-10-23 節がある" "3 項目が箇条書きで記録されている"]
           :context []
           :notes ["証明書の期限を確認し、残り 45 日だった。" "監視アラートのしきい値を 80% から 85% に変更した。" "次回は runbook の手順を見直す。"]}
  :expect {:allowed-changes ["Projects/task-board-localllm-docs/pilot/weekly.md"]
           :must-contain {"Projects/task-board-localllm-docs/pilot/weekly.md" ["## 2026-10-23" "45 ?日" "85 ?%" "runbook"]}
           :unchanged-sections {"Projects/task-board-localllm-docs/pilot/weekly.md" ["## 2026-10-09" "## 2026-10-16"]}
           :numbers-from []}}

 {:id "C03" :title "要約からノート更新（概要節を Context の説明から書き直す）" :group "edit"
  :targets ["Projects/task-board-localllm-docs/pilot/runbook.md"]
  :ticket {:title "runbook の概要節を要約で書き直す"
           :summary "`Projects/task-board-localllm-docs/pilot/runbook.md` の「## 概要」節を、Context の説明を 2〜3 文に要約した内容へ差し替える。設計メモ A へのリンクは残す。"
           :acceptance ["概要節が 2〜3 文の要約になっている" "設計メモ A へのリンクが残っている" "数値は Context にあるものだけを使う"]
           :context ["sample-stream は検証用の配信サーバで、2026 年 6 月から運用している。Envoy 経由で公開され、idle timeout は 300 秒。日常運用は当番が行い、設定変更だけ owner が承認する。障害時は 30 分以内に復旧しなければ owner へエスカレーションする。"]
           :notes []}
  :expect {:allowed-changes ["Projects/task-board-localllm-docs/pilot/runbook.md"]
           :must-contain {"Projects/task-board-localllm-docs/pilot/runbook.md" ["Envoy" "source-a" "30 ?分"]}
           :unchanged-sections {"Projects/task-board-localllm-docs/pilot/runbook.md" ["## 現状" "## 手順" "## 注意"]}
           :numbers-from []}}

 {:id "C04" :title "複数参照の出典付き統合" :group "edit"
  :targets ["Projects/task-board-localllm-docs/pilot/summary.md"]
  :ticket {:title "設計メモ A/B/C を比較表に統合"
           :summary "`Projects/task-board-localllm-docs/pilot/summary.md` の「## 比較」節を、参照ノート A・B・C の要点を 1 行ずつまとめた表（列: 出典 / 要点）に差し替える。出典列は各ノートへの wikilink にする。"
           :acceptance ["A・B・C それぞれの要点が 1 行以上ある" "出典が wikilink で示されている" "参照ノートに無い事実を書かない"]
           :context ["関連ノート: [[Projects/task-board-localllm-docs/refs/source-a]]、[[Projects/task-board-localllm-docs/refs/source-b]]、[[Projects/task-board-localllm-docs/refs/source-c]]。source-d という設計メモは存在しないので含めない。"]
           :notes []}
  :expect {:allowed-changes ["Projects/task-board-localllm-docs/pilot/summary.md"]
           :must-contain {"Projects/task-board-localllm-docs/pilot/summary.md" ["\\[\\[Projects/task-board-localllm-docs/refs/source-a" "\\[\\[Projects/task-board-localllm-docs/refs/source-b" "\\[\\[Projects/task-board-localllm-docs/refs/source-c" "replica|レプリカ|2 replica" "ConfigMap" "Envoy|300 ?秒|cert-manager|Loki"]}
           :must-not-contain {"Projects/task-board-localllm-docs/pilot/summary.md" ["source-d"]}
           :unchanged-sections {"Projects/task-board-localllm-docs/pilot/summary.md" ["## 目的" "## 備考"]}
           :numbers-from ["Projects/task-board-localllm-docs/refs/source-a.md" "Projects/task-board-localllm-docs/refs/source-b.md" "Projects/task-board-localllm-docs/refs/source-c.md"]}}

