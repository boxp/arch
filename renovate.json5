{
  extends: [
    'config:recommended',
    'github>aquaproj/aqua-renovate-config#2.14.0',
    'github>aquaproj/aqua-renovate-config:file#2.14.0(^(.*/)?aqua/[^/]*\\.ya?ml$)',
    'github>aquaproj/aqua-renovate-config:file#2.14.0(^(.*/)?aqua/imports/[^/]*\\.ya?ml$)',
    'github>suzuki-shunsuke/renovate-config#4.0.0',
  ],
  labels: [
    'renovate:{{depName}}',
    'renovate:{{depName}}/{{newVersion}}',
    'datasource:{{datasource}}',
  ],
  major: {
    automerge: false,
  },
  // BOXP-235: actions.lock 再生成に使う gh-actions-lock の版。actions-lock-verify.yml の
  // GH_ACTIONS_LOCK_VERSION と揃える。更新手順は docs/project_docs/BOXP-235/plan.md。
  constraints: {
    ghActionsLock: "v0.2.0",
  },
  prHourlyLimit: 10,
  prConcurrentLimit: 10,
  branchConcurrentLimit: 20,
  customManagers: [
    // codex (IS01 armv7 クロスビルド用)。
    // 🚨 alpha を拾わないよう ^rust-v<major>.<minor>.<patch>$ に限定する。
    //    alpha は 1 日に複数出るため、追うと PR が溢れる。
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-armv7/codex-version\\.env$/"],
      matchStrings: [
        "CODEX_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "openai/codex",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^rust-v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
    },
    // yazi (IS01 armv7 クロスビルド用)。
    // yazi は armv7 のバイナリを配布していないのでこちらでビルドする。
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/yazi-armv7/yazi-version\\.env$/"],
      matchStrings: [
        "YAZI_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "sxyazi/yazi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
    },
    // Kubernetes version (playbooks)
    {
      customType: "regex",
      managerFilePatterns: ["/^ansible/playbooks/.*\\.yml$/"],
      matchStrings: [
        "kubernetes_version:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      depNameTemplate: "kubernetes/kubernetes",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    // CRI-O version (playbooks)
    {
      customType: "regex",
      managerFilePatterns: ["/^ansible/playbooks/.*\\.yml$/"],
      matchStrings: [
        "crio_version:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      depNameTemplate: "cri-o/cri-o",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    // kube-vip version
    {
      customType: "regex",
      managerFilePatterns: ["/^ansible/roles/kube_vip/defaults/main\\.yml$/"],
      matchStrings: [
        "kube_vip_version:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      depNameTemplate: "kube-vip/kube-vip",
      datasourceTemplate: "github-releases"
    },
    // Codex workspace npm package versions
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG CODEX_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "@openai/codex",
      datasourceTemplate: "npm"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG CLAUDE_CODE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "@anthropic-ai/claude-code",
      datasourceTemplate: "npm"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG EVEN_TERMINAL_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "@evenrealities/even-terminal",
      datasourceTemplate: "npm"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG PI_AGENT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "@earendil-works/pi-coding-agent",
      datasourceTemplate: "npm"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/(codex-workspace|hermes-agent)/Dockerfile$/"],
      matchStrings: [
        "ARG OBSIDIAN_HEADLESS_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "obsidian-headless",
      datasourceTemplate: "npm"
    },
    // Codex workspace GitHub release versions
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG GH_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "cli/cli",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG GHQ_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "x-motemen/ghq",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG GWQ_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "d-kuro/gwq",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG CEEKER_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "boxp/ceeker",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/(codex-workspace|hermes-agent)/Dockerfile$/"],
      matchStrings: [
        "ARG BABASHKA_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "babashka/babashka",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG LAZYGIT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "jesseduffield/lazygit",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG YAZI_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "sxyazi/yazi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG KUBECTL_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "kubernetes/kubernetes",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG KUSTOMIZE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "kubernetes-sigs/kustomize",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^kustomize/v(?<version>.*)$"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG CURSOR_AGENT_VERSION=(?<currentValue>[^\\s]+)"
      ],
      depNameTemplate: "cursor-agent",
      packageNameTemplate: "cursor-agent",
      datasourceTemplate: "custom.cursor-agent",
      versioningTemplate: "loose"
    },
    // Codex workspace NodeSource major version
    {
      customType: "regex",
      managerFilePatterns: ["/^docker/codex-workspace/Dockerfile$/"],
      matchStrings: [
        "ARG NODE_MAJOR=(?<currentValue>[0-9]+)"
      ],
      depNameTemplate: "node",
      datasourceTemplate: "node-version"
    }
  ],
  customDatasources: {
    "cursor-agent": {
      defaultRegistryUrlTemplate: "https://cursor.com/install",
      format: "plain"
    }
  },
  packageRules: [
    // SD.Next supports Python 3.12 on noble; keep OS upgrades manual.
    // Digest updates within Ubuntu 24.04 remain enabled.
    {
      matchFileNames: ["docker/sdnext-ipex/Dockerfile"],
      matchManagers: ["dockerfile"],
      matchPackageNames: ["ubuntu"],
      allowedVersions: "/^24\\.04(?:\\.[0-9]+)?$/",
    },
    {
      additionalBranchPrefix: '{{packageFileDir}}-',
      commitMessageSuffix: '({{packageFileDir}})',
      matchPackageNames: [
        '/.*/',
      ],
    },
    // 🚨 壁 13: codex armv7 は実機の glibc 2.36 との互換性と amd64/armhf を
    // 同一 repository から取るため Debian bookworm がビルド契約。
    // tag 更新で release/glibc が変わるのは禁止する。
    // digest の更新は引き続き許可する。
    {
      matchFileNames: ["docker/codex-armv7/Dockerfile"],
      matchManagers: ["dockerfile"],
      matchPackageNames: ["debian"],
      allowedVersions: "bookworm-slim",
    },
    {
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["cloudflare/cloudflare"],
      allowedVersions: "<5.0.0",
      description: "Allow v4.x updates only. Block v5.x until official migration tools are available (March 2026)"
    },
    {
      matchDatasources: ["custom.cursor-agent"],
      extractVersion: "downloads\\.cursor\\.com/lab/(?<version>[^/]+)/\\$\\{OS\\}/\\$\\{ARCH\\}/agent-cli-package\\.tar\\.gz"
    },
    // even-terminal は 0.x のため minor 更新でも起動仕様が変わり得る (BOXP-205:
    // 0.10 で config.json 必須化 + bind 先変更により codex-workspace が crash loop)。
    // image build は required check ではないので、Build Codex Workspace Image の
    // smoke test 成功を確認してから手動 merge する。
    {
      matchPackageNames: ["@evenrealities/even-terminal"],
      automerge: false,
      addLabels: ["manual-review-required"]
    },
    // Kubernetes components (manual review required)
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["kubernetes/kubernetes", "cri-o/cri-o"],
      groupName: "Kubernetes components",
      automerge: false,
      prPriority: -10,
      labels: ["kubernetes", "manual-review-required"]
    },
    // kube-vip (manual review)
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["kube-vip/kube-vip"],
      automerge: false,
      labels: ["kubernetes", "kube-vip"]
    },
    // BOXP-313: Hermes Agent upstream image (docker/hermes-agent/Dockerfile).
    // FROM は「安定版 tag + multi-arch index digest」で固定し、dockerfile manager に
    // version と digest の両方を追わせる (tag 無し digest だけだと version lookup が
    // できず Dependency Dashboard で "Updates: undefined" になる)。
    // - Docker Hub には v0.22.x (SemVer) のほか旧い日付形式 v2026.9.24 等と rc.N-v0.22.x
    //   が同居する。docker versioning では v2026.x が「major 2026」として最新扱いになる
    //   ため、allowedVersions で v0.MINOR.PATCH 形式の安定版 tag だけに限定する。
    //   (rc.N-… は docker versioning として無効なので元から候補に入らない)
    // - 上流 minor 更新は config 自動移行 / s6 起動方式の変更を伴い得るので automerge
    //   しない。digest-only 更新 (同 tag の再 push) も image build の smoke test を見てから
    //   手動 merge する。更新手順・rollback は docs/project_docs/BOXP-313/plan.md。
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/nousresearch/hermes-agent"],
      allowedVersions: "/^v?0\\.[0-9]+\\.[0-9]+$/",
      automerge: false,
      addLabels: ["hermes-agent", "manual-review-required"],
    },
    // 🚨 BOXP-207: apply.yaml / test.yaml（とそこから呼ぶ wc-*.yaml）が main で変わると、
    // GitHub の保護機能により、write 権限者が Web で承認するまで以後の run が実行されない。
    // automerge だと誰も見ていない時間に止まり始めるため、workflow の更新は週 1 回・
    // 1 PR にまとめ、merge した人がその場で承認できるよう手動 merge にする。
    // - schedule は PR（branch）を新しく作れる時間帯で、UTC 指定（月曜 02:00〜08:59 JST）。
    //   時間帯の中で merge すると、同じ時間帯の次の実行で 2 本目の PR が作られ得る。
    //   そのため作成は merge しない早朝に限り、merge は月曜 09:00 JST 以降に週 1 本だけ行う。
    // - separateMajorMinor を無効にして、major 更新が別 PR に分かれないようにする。
    // 手順: docs/project_docs/BOXP-207/runbook.md
    {
      matchFileNames: [".github/workflows/**"],
      groupName: "GitHub Actions workflows",
      separateMajorMinor: false,
      schedule: ["* 17-23 * * 0"],
      automerge: false,
    },
    // BOXP-235: GitHub Actions workflow lockfile (.github/workflows/actions.lock) を全 workflow に展開。
    // 上の週次 PR (手動 merge) で onboard 済み workflow の action が更新されると、Renovate は
    // repo root で `gh actions-lock --no-interactive --no-narrow --no-migrate-local-actions` を実行し、
    // 同じ branch に actions.lock の再生成を commit する (artifacts update)。CLI の版は
    // 先頭の constraints.ghActionsLock で固定する (lockfile v0.0.3 を読める v0.2.0 以上が必須。
    // Renovate 44.158.2 以前の既定 v0.1.6 は v0.0.3 を読めず再生成に失敗する)。
    // 手順: docs/project_docs/BOXP-207/runbook.md、docs/project_docs/BOXP-235/plan.md
  ],
}
