#!/usr/bin/env bb
(require '[clj-yaml.core :as yaml])
(def manifest (yaml/parse-string (slurp "deployment.yaml") :keywords false))
(def failures (atom 0))
(defn check [name ok?] (if ok? (println "PASS" name) (do (println "FAIL" name) (swap! failures inc))))
(def container (first (get-in manifest ["spec" "template" "spec" "containers"])))
(def env (into {} (map (fn [e] [(get e "name") (get e "value")]) (get container "env"))))
(check "LOG_LEVEL added" (= "info" (get env "LOG_LEVEL")))
(check "existing env kept" (and (= "8080" (get env "APP_PORT")) (= "UTC" (get env "TZ"))))
(check "env count" (= 3 (count (get container "env"))))
(check "replicas unchanged" (= 2 (get-in manifest ["spec" "replicas"])))
(check "image unchanged" (= "example.invalid/sample-app:1.2.3" (get container "image")))
(check "labels unchanged" (= {"app" "sample-app"} (get-in manifest ["metadata" "labels"])))
(check "ports unchanged" (= [{"containerPort" 8080}] (get container "ports")))
(check "single container" (= 1 (count (get-in manifest ["spec" "template" "spec" "containers"]))))
(System/exit (if (pos? @failures) 1 0))
