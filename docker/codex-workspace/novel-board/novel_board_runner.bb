             (and (str/includes? p "執筆時に守る人間の指示") (str/includes? p "- 冒頭を明るく"))))
    (check "write prompt omits TBD instructions"
           (not (str/includes? (:prompt (writer-user-prompt "NOVEL-0" {:title "T"} "## Requirements\n\n- Title: T\n\n## Outline\n\n1. a\n\n## Review Instructions\n\nTBD\n" :write nil))
                               "Review Instructions")))
    (let [empty-exploration {:catalog-count 0 :candidates [] :gaps [] :selection {:status :skipped} :text "" :query-chars 0}]
      (check "regroom prompt asks for Applied / Unapplied / Unresolved"
             (let [p (groom-user-prompt "NOVEL-0" {:title "T"} "## Requirements\n\n- Title: T\n\n## Outline\n\n1. a\n\n## Review Instructions\n\n- 舞台を冬に\n" :regroom empty-exploration)]
               (and (str/includes? p "- 舞台を冬に") (str/includes? p "## Applied") (str/includes? p "## Unresolved") (str/includes? p "本文は書かないでください"))))
      (check "groom prompt passes Backlog feedback"
             (str/includes? (groom-user-prompt "NOVEL-0" {:title "T"} "## Requirements\n\nTBD\n\n## Outline\n\nTBD\n\n## Review Instructions\n\n- 短編にして\n" :groom empty-exploration) "- 短編にして"))
      (check "groom prompt carries the exploration inventory and canon rules"
             (let [exploration {:catalog-count 3 :query-chars 10 :selection {:status :ok}
                                :candidates [{:rel "S/a.md" :status :read :reasons ["名前一致: a"] :chars-total 10 :chars-included 10 :sha256 "abc"}
                                             {:rel "S/b.md" :status :unread-budget :reasons ["モデル選定: x"]}]
                                :gaps [{:type :required-missing :detail "必須設定 `S/R.md` が設定 root 内に見つかりません"}]
                                :text "## 参照: S/a.md（全文 10 字）\nbody-a"}
                   p (groom-user-prompt "NOVEL-0" {:title "T"} "## Requirements\n\nTBD\n\n## Outline\n\nTBD\n" :groom exploration)]
               (and (str/includes? p "読んだ設定ノート（本文は下の参照資料）: S/a.md")
                    (str/includes? p "読めなかった候補: S/b.md（unread-budget）")
                    (str/includes? p "必須設定 `S/R.md` が設定 root 内に見つかりません")
                    (str/includes? p "body-a")
                    (str/includes? p "既存設定のように書かないでください")
                    (str/includes? p "## Unresolved")))))
    ;; Setting exploration helpers (BOXP-305)
    (check "reference-targets include Review Instructions links"
           (= ["ひとはこさんバース/キャラ設定/a.md" "世界観設定/b|b"]
              (reference-targets "## Requirements\n\n- References: `ひとはこさんバース/キャラ設定/a.md`\n\n## Outline\n\nTBD\n\n## Review Instructions\n\n[[世界観設定/b|b]] を読んで\n")))
    (check "frontmatter-list parses inline and block lists"
           (and (= ["リリス・テイル" "Lilith"] (frontmatter-list ["---" "aliases: [リリス・テイル, \"Lilith\"]" "---" "# x"] "aliases"))
                (= ["凛" "りん"] (frontmatter-list ["---" "title: x" "aliases:" "  - 凛" "  - りん" "canon: true" "---"] "aliases"))
                (nil? (frontmatter-list ["# no frontmatter"] "aliases"))))
    (check "lexical-hits match title, stem and aliases but not README"
           (let [entry {:title "リリス・テイル" :stem "lilith-tail" :aliases ["Lilith Tail"]}]
             (and (= ["リリス・テイル"] (lexical-hits entry "リリス・テイルの初登場エピソード"))
                  (= ["リリス・テイル" "lilith-tail" "Lilith Tail"] (lexical-hits entry "リリステイル lilithtail"))
                  (empty? (lexical-hits entry "無関係な話"))
                  (empty? (lexical-hits {:title "README" :stem "README" :aliases []} "README を読む")))))
    (check "exploration-gaps flag zero read, required unread and budget"
           (let [catalog [{:rel "R/世界観設定/README.md"} {:rel "R/a.md"}]
                 gaps (with-redefs [required-setting-paths (constantly ["R/世界観設定/README.md"])]
                        (exploration-gaps catalog
                                          [{:rel "R/世界観設定/README.md" :status :unread-budget :reasons ["必須共通規則"]}
                                           {:rel "R/a.md" :status :unread-cap :reasons ["名前一致: a"]}]
                                          {:status :ok :ambiguous [{:name "凛" :candidates ["R/a.md"] :reason "2 候補"}] :missing []}
                                          []))]
             (= [:required-unread :unread-budget :zero-read :ambiguous] (mapv :type gaps))))
    (check "exploration-gaps is empty when the required note was read"
           (with-redefs [required-setting-paths (constantly ["R/README.md"])]
             (empty? (exploration-gaps [{:rel "R/README.md"}] [{:rel "R/README.md" :status :read :reasons ["必須共通規則"]}] {:status :ok :ambiguous [] :missing []} []))))
    (check "exploration evidence has counts only"
           (let [ev (exploration-evidence {:catalog-count 2 :query-chars 5 :selection {:status :ok :proposed 2 :accepted [{:rel "R/a.md"}] :rejected-count 1}
                                           :candidates [{:rel "R/a.md" :status :read}] :gaps [{:type :missing :detail "x"}] :text "body"})]
             (and (= 1 (:candidates ev)) (= {:read 1} (:statuses ev)) (= {:missing 1} (:gaps ev))
                  (not (str/includes? (pr-str ev) "R/a.md")) (not (str/includes? (pr-str ev) "body")))))
    (check "reference context lists read, unread and gaps without bodies"
           (let [lines (reference-context-lines "run-1" :groom "localllm"
                                                {:catalog-count 4 :selection {:status :ok :proposed 3 :accepted 2}
                                                 :candidates [{:rel "R/a.md" :status :read-truncated :reasons ["名前一致: a"] :chars-total 9000 :chars-included 6000 :sha256 "0123456789ab"}
                                                              {:rel "R/b.md" :status :unread-budget :reasons ["モデル選定: 舞台"]}
                                                              {:rel "R/c.md" :status :excluded-symlink :reasons ["名前一致: c"]}]
                                                 :gaps [{:type :zero-read :detail "g"}]}
                                                "凛が2人いる")
                 text (str/join "\n" lines)]
             (and (str/includes? text "読取（先頭のみ）: `R/a.md`（9000 字中 6000 字, sha256 0123456789ab")
                  (str/includes? text "未読（unread-budget）: `R/b.md`")
                  (str/includes? text "除外 1 件")
                  (str/includes? text "不足/未解決: g")
                  (str/includes? text "## Unresolved): 凛が2人いる")
                  (str/includes? text "提案 3 件 / 採用 2 件"))))
    (let [tmp (str (fs/create-temp-dir))
          root (fs/path tmp "vault")]
      (try
        (fs/create-dirs (fs/path root "S" "キャラ設定"))
        (fs/create-dirs (fs/path tmp "outside"))
        (spit (str (fs/path root "S" "キャラ設定" "a.md")) "---\naliases: [エー]\n---\n# 人物A\n\n本文 [[人物B]] を参照\n")
        (spit (str (fs/path root "S" "キャラ設定" "b.md")) "# 人物B\n\n本文B\n")
        (spit (str (fs/path root "S" "キャラ設定" "old.md")) "---\ncanon: false\n---\n# 旧案\n")
        (spit (str (fs/path tmp "outside" "x.md")) "# 外部\n")
        (fs/create-sym-link (fs/path root "S" "キャラ設定" "link.md") (fs/path tmp "outside" "x.md"))
        (with-redefs [vault (constantly (str root))
                      setting-roots (constantly ["S"])
                      allowed-reference-dirs (constantly ["S"])]
          (let [catalog (setting-catalog)
                by-rel (into {} (map (juxt :rel identity) catalog))]
            (check "setting-catalog reads titles, aliases and exclusions"
                   (and (= 4 (count catalog))
                        (= "人物A" (:title (by-rel "S/キャラ設定/a.md")))
                        (= ["エー"] (:aliases (by-rel "S/キャラ設定/a.md")))
                        (nil? (:excluded (by-rel "S/キャラ設定/b.md")))
                        (= :excluded-noncanon (:excluded (by-rel "S/キャラ設定/old.md")))
                        (= :excluded-symlink (:excluded (by-rel "S/キャラ設定/link.md")))))
            (check "catalog link resolution follows one hop"
                   (= ["S/キャラ設定/b.md"] (map :rel (catalog-matches-link (remove :excluded catalog) "人物B"))))))
        (finally (fs/delete-tree tmp))))
    (check "cloud allowed sections and groom prompt"
           (let [allowed (agent-writable-sections :groom)
                 line (first (filter #(str/starts-with? % "Allowed writes:") (str/split-lines (cloud-prompt "NOVEL-0" {} "" :groom "claude-sonnet"))))]
             (and (= allowed (agent-writable-sections :regroom))
                  (= ["## Change History"] (agent-writable-sections :write) (agent-writable-sections :revise))
                  (every? #(str/includes? line %) allowed))))
    (check "cloud note boundaries and cloud exploration summary"
           (let [before "---\ntitle: x\nseries: a\n---\n# Novel\n## Requirements\nold\n## Outline\nold\n## Draft Preview\nold\n## Run History\nold\n"
                 edited (str/replace before "## Requirements\nold" "## Requirements\nnew")
                 exploration {:catalog-count 33 :selection {:status :cloud} :candidates [{:rel "a.md" :status :candidate-for-agent :reasons []}] :gaps []}
                 context (str/join "\n" (reference-context-lines "r" :groom "claude" exploration nil))]
             (and (nil? (cloud-note-violation before edited :groom))
                  (str/includes? (cloud-note-violation before edited :write) "## Requirements")
                  (str/includes? (cloud-note-violation before (str/replace before "series: a" "series: b") :groom) "frontmatter")
                  (nil? (cloud-note-violation before (str/replace before "title: x" "title: y\nstatus: draft") :groom))
                  (nil? (cloud-note-violation before (str/replace before "## Run History\nold" "## Run History\nold\n- runner") :write))
                  (nil? (cloud-note-violation before (str/replace before "## Outline\nold" "## Outline\n\n## 第1章  \n導入\n") :groom))
                  (nil? (cloud-note-violation before (str/replace before "title: x" "title: x\nassignee: boxp") :groom))
                  (str/includes? (cloud-note-violation before (str/replace before "## Draft Preview\nold" "## Draft Preview\nnew") :groom) "## Draft Preview")
                  (str/includes? context "- 候補: `a.md`")
                  (str/includes? context "runner 未判定")
                  (not (str/includes? context "読取 0"))
                  (not (str/includes? context "不足/未解決: なし")))))
    (check "cloud prompt mentions instructions for regroom and write"
           (let [c "## Requirements\n\n- Title: T\n\n## Outline\n\n1. a\n\n## Review Instructions\n\n- 舞台を冬に\n"]
             (and (str/includes? (cloud-prompt "NOVEL-0" {} c :regroom "claude-sonnet") "Do NOT write or change the manuscript")
                  (str/includes? (cloud-prompt "NOVEL-0" {} c :write "claude-sonnet") "follow them as well")
                  (not (str/includes? (cloud-prompt "NOVEL-0" {} "## Review Instructions\n\nTBD\n" :write "claude-sonnet") "follow them as well")))))
    ;; Shutdown race: an agent registered while `stop-in-flight-agents!` is
    ;; waiting, and one registered after it finished, must both be killed.
    (let [wait-for-file! (fn [path]
                           (let [deadline (+ (System/currentTimeMillis) 5000)]
                             (while (and (not (fs/exists? path)) (< (System/currentTimeMillis) deadline))
                               (Thread/sleep 20))))
          start-resistant! (fn []
                             ;; Only return once the trap is installed, otherwise a
                             ;; TERM sent right after start would still kill it.
                             (let [ready (str (fs/create-temp-file {:prefix "shutdown-ready"}))]
                               (fs/delete ready)
                               (let [proc (:proc (p/process ["setsid" "sh" "-c"
                                                             (str "trap '' TERM; : > " ready "; exec sleep 60")]
                                                            {:out :string :err :string}))]
                                 (wait-for-file! ready)
                                 (fs/delete-if-exists ready)
                                 proc)))
          early (start-resistant!)
          late (atom nil)
          after (atom nil)
          orphaning (atom nil)
          ;; Created by the child itself; `wait-for-file!` must not see an empty file.
          orphan-pid-file (let [path (str (fs/create-temp-file {:prefix "shutdown-orphan" :suffix ".pid"}))]
                            (fs/delete path)
                            path)
          orphan-pid (fn [] (when (fs/exists? orphan-pid-file)
                              (some-> (slurp orphan-pid-file) str/trim not-empty)))
          ;; A killed orphan may linger as a zombie until init reaps it, so
          ;; treat zombies as stopped and allow a short settle time.
          orphan-alive? (fn []
                          (when-let [pid (orphan-pid)]
                            (let [deadline (+ (System/currentTimeMillis) 3000)]
                              (loop []
                                (let [stat (str/trim (:out @(p/process ["ps" "-o" "stat=" "-p" pid] {:out :string :err :string})))
                                      alive (and (seq stat) (not (str/starts-with? stat "Z")))]
                                  (if (and alive (< (System/currentTimeMillis) deadline))
                                    (do (Thread/sleep 50) (recur))
                                    alive))))))]
      (try
        (reset! shutdown-requested? true)
        (register-agent-process! "NOVEL-race-early" early)
        (let [stopper (future (with-redefs [shutdown-agent-grace-seconds (constantly 2)]
                                (stop-in-flight-agents!)))]
          (Thread/sleep 500)
          (reset! late (start-resistant!))
          (register-agent-process! "NOVEL-race-late" @late)
          ;; Agent that exits on TERM but leaves a TERM-ignoring child behind,
          ;; and is unregistered (as `run-agent!` does) before the final KILL.
          (reset! orphaning (:proc (p/process ["setsid" "sh" "-c"
                                               (str "sh -c 'trap \"\" TERM; echo $$ > " orphan-pid-file "; exec sleep 60' & wait")]
                                              {:out :string :err :string})))
          ;; Wait for the child's trap before the registration TERMs the group.
          (wait-for-file! orphan-pid-file)
          (register-agent-process! "NOVEL-race-orphaning" @orphaning)
          (.waitFor ^java.lang.Process @orphaning 3 java.util.concurrent.TimeUnit/SECONDS)
          (unregister-agent-process! "NOVEL-race-orphaning")
          @stopper)
        (reset! after (start-resistant!))
        (register-agent-process! "NOVEL-race-after" @after)
        (doseq [p [early @late @after]]
          (try (.waitFor ^java.lang.Process p 3 java.util.concurrent.TimeUnit/SECONDS)
               (catch Exception _ nil)))
        (check "agents registered during or after shutdown are killed"
               (and @in-flight-agents-stopped?
                    (not (.isAlive ^java.lang.Process early))
                    (not (.isAlive ^java.lang.Process @late))
                    (not (.isAlive ^java.lang.Process @after))
                 (some? (orphan-pid))
                 (not (orphan-alive?))))
        (finally
          (when-let [pid (orphan-pid)]
            @(p/process ["/bin/kill" "-KILL" pid] {:out :string :err :string}))
          (fs/delete-if-exists orphan-pid-file)
          (doseq [p (remove nil? [early @late @after @orphaning])
                  :when (.isAlive ^java.lang.Process p)]
            (signal-process-group! p "KILL"))
          (reset! in-flight-agent-processes {})
          (reset! in-flight-agents-stopped? false)
          (reset! shutdown-requested? false))))
    ;; Shutdown after the lock was taken or after the generation finished: the
    ;; live flag must be consulted atomically with entering each commit section
    ;; (start transition, `finish-run!`). Each window records the run as
    ;; interrupted and keeps the lock; a transition already begun completes.
    (doseq [[label raise-at] [["shutdown raised before the start transition" :before-start]
                              ["shutdown raised during the start transition" :during-start]
                              ["shutdown raised after the run finished" :after-run]
                              ["shutdown raised during finish-run!" :during-finish]]]
      (let [calls (atom [])
            record! (fn [k & args] (swap! calls conj (into [k] args)) nil)
            lock {:run-id (str "shutdown-commit-" (name raise-at)) :owner-id "test-owner"}
            card {:novel-id "NOVEL-0" :status "draft" :assignee "claude-fable" :lane "Draft" :title "T" :nsfw false}]
        (try
          (with-redefs [note-frontmatter (fn [_] {:assignee "claude-fable"})
                        note-content (fn [_] "")
                        candidate-action (fn [& _] :write)
                        acquire-lock! (fn [& _]
                                        (when (= :before-start raise-at) (request-shutdown!))
                                        lock)
                        current-card (fn [_] card)
                        heartbeat! (fn [& _] (future nil))
                        run-dir (fn [& _] "/nonexistent")
                        ensure-private-dir! identity
                        move-card! (fn [& args]
                                     (apply record! :move-card! args)
                                     (when (= :during-start raise-at) (request-shutdown!)))
                        update-frontmatter! (partial record! :update-frontmatter!)
                        append-history! (partial record! :append-history!)
                        mark-run! (fn [_ _ status _] (record! :mark-run! status))
                        run-write! (fn [& _]
                                     (record! :run-write!)
                                     (when (= :after-run raise-at) (reset! shutdown-requested? true))
                                     {:ok? true :manuscript-chars 10})
                        record-applied-instructions! (partial record! :record-applied-instructions!)
                        finish-run! (fn [& _]
                                      (record! :finish-run!)
                                      (when (= :during-finish raise-at) (request-shutdown!)))
                        release-lock! (partial record! :release-lock!)
                        log! (fn [& _] nil)]
            (process-card! card))
          (finally
            (reset! shutdown-requested? false)))
        (let [kinds (set (map first @calls))
              count-of (fn [k] (count (filter #(= k (first %)) @calls)))
              interrupted? (some #{[:mark-run! :interrupted]} @calls)
              failed? (some #{[:mark-run! :failed]} @calls)
              started? (= 1 (count-of :move-card!))
              start-complete? (and (= [[:move-card! "NOVEL-0" "in-progress" nil]] (filter #(= :move-card! (first %)) @calls))
                                   (= 1 (count-of :update-frontmatter!))
                                   (= 1 (count-of :append-history!))
                                   (some #{[:mark-run! :running]} @calls))
              ran? (contains? kinds :run-write!)
              finished? (contains? kinds :finish-run!)
              released? (contains? kinds :release-lock!)
              ok? (and (zero? @committing-cards)
                       (not failed?)
                       (case raise-at
                         :before-start (and (not started?) (not ran?) (not finished?) interrupted? (not released?)
                                            (zero? (count-of :update-frontmatter!)) (zero? (count-of :append-history!))
                                            (not-any? #{[:mark-run! :running]} @calls))
                         :during-start (and start-complete? (not ran?) (not finished?) interrupted? (not released?))
                         :after-run (and start-complete? ran? (not finished?) interrupted? (not released?))
                         :during-finish (and start-complete? ran? finished? (not interrupted?) released?)))]
          (if ok?
            (println (str "PASS: " label
                          (case raise-at
                            :during-finish " completes the commit and releases the lock"
                            :during-start " completes the start transition, skips the run and keeps the lock"
                            " keeps the lock and records an interrupted run")))
            (do
              (println (str "FAIL: " label " committing=" @committing-cards " calls=" (pr-str @calls)))
              (swap! failures conj label))))))

    ;; The hook's finalize wait must cover a lifecycle commit that began before
    ;; the flag was raised, not only `in-flight`. A commit is waited for up to
    ;; the shutdown commit budget (measured from the hook start), not only the
    ;; short finalize window, and is given up at the budget so the Pod still
    ;; exits inside terminationGracePeriodSeconds.
    (doseq [{:keys [label finalize budget hold-ms probe-ms expect-early? expect-log]}
            [{:label "shutdown finalize wait covers an in-progress lifecycle commit"
              :finalize 3 :budget 10 :hold-ms 500 :probe-ms 500
              :expect-early? false
              :expect-log "shutdown: in-flight card processing finalized"}
             {:label "shutdown finalize wait covers a lifecycle commit longer than the finalize window"
              :finalize 1 :budget 10 :hold-ms 2500 :probe-ms 2000
              :expect-early? false
              :expect-log "shutdown: in-flight card processing finalized"}
             {:label "shutdown finalize wait gives up a lifecycle commit at the shutdown commit budget"
              :finalize 1 :budget 2 :hold-ms 5000 :probe-ms 3500
              :expect-early? true
              :expect-log "shutdown: 1 lifecycle commit(s) still in progress 2s after the shutdown started; exiting to stay inside terminationGracePeriodSeconds, the next owner recovers the card through the planned-shutdown marker"}]]
      (let [logs (atom [])]
        (try
          (reset! shutdown-started-at-ms nil)
          (swap! committing-cards inc)
          (let [waiter (future (with-redefs [shutdown-finalize-seconds (constantly finalize)
                                             shutdown-commit-budget-seconds (constantly budget)
                                             log! (fn [m] (swap! logs conj m))]
                                 (await-in-flight-finalization!)))
                releaser (future (Thread/sleep hold-ms) (swap! committing-cards dec))]
            (Thread/sleep probe-ms)
            (let [returned-early? (future-done? waiter)]
              @releaser
              (deref waiter 5000 :timeout)
              (check label
                     (and (= (boolean expect-early?) returned-early?)
                          (future-done? waiter)
                          (some #(= expect-log %) @logs)))))
          (finally
            (reset! committing-cards 0)
            (reset! shutdown-started-at-ms nil)))))

    (if (seq @failures)
      (do (println (str "FAILED: " (count @failures) " test(s)")) (System/exit 1))
      (println "All tests passed."))))

(defn usage []
  (println "usage: novel_board_runner.bb <tick|loop|sync|sync-drafts NOVEL-N|prepare-shutdown|recover|test>")
  (System/exit 2))

(case (or (first *command-line-args*) "tick")
  "tick" (do (ensure-root!) (recover-locks!) (tick!) (drain-in-flight!) (sync-all!) (sync-drafts! nil) (add-draft-board-links!))
  "loop" (loop!)
  "sync" (do (ensure-root!) (sync-all!))
  "sync-drafts" (do (ensure-root!)
                    (let [id (second *command-line-args*)]
                      (when-not (and (= 2 (count *command-line-args*)) (safe-novel-id? id)) (usage))
                      (when-not (current-card id) (fail "draft card not found"))
                      (sync-note-from-card! (current-card id))
                      (sync-drafts! id true)
                      (add-draft-board-links! id)))
  "prepare-shutdown" (prepare-shutdown!)
  "recover" (recover-locks!)
  "test" (run-tests!)
  (usage))
