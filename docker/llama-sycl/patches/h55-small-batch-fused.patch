+// Only split layouts for which each token is an independent, contiguous MMVQ input.
+static bool ggml_sycl_mul_mat_id_small_batch(const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+    const int64_t n = src1->ne[2];
+    if (n < 2 || n > g_ggml_sycl_small_batch_fused || src1->ne[3] != 1 ||
+        ids->ne[1] != n || ids->ne[2] != 1 || ids->ne[3] != 1 ||
+        ids->type != GGML_TYPE_I32 || ids->nb[0] != sizeof(int32_t) ||
+        ids->nb[1] < (size_t) ids->ne[0] * sizeof(int32_t) ||
+        dst->ne[0] != src0->ne[1] || dst->ne[1] != ids->ne[0] ||
+        dst->ne[2] != n || dst->ne[3] != 1 || dst->nb[0] != sizeof(float) ||
+        dst->nb[1] < (size_t) dst->ne[0] * sizeof(float) ||
+        dst->nb[2] < (size_t) dst->ne[1] * dst->nb[1] ||
+        src1->nb[2] < (size_t) src1->ne[1] * src1->nb[1]) {
+        return false;
+    }
+    ggml_tensor src1_view = *src1;
+    ggml_tensor ids_view = *ids;
+    ggml_tensor dst_view = *dst;
+    src1_view.ne[2] = 1;
+    ids_view.ne[1] = 1;
+    dst_view.src[1] = &src1_view;
+    dst_view.src[2] = &ids_view;
+    return !ggml_sycl_mul_mat_id_single_needs_sync(&dst_view);
+}
+
+static bool ggml_sycl_mul_mat_id_needs_sync(const ggml_tensor * dst) {
+    return ggml_sycl_mul_mat_id_single_needs_sync(dst) && !ggml_sycl_mul_mat_id_small_batch(dst);
+}
