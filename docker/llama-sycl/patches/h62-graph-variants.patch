+// Select by the full saved properties, never by uid or node pointer alone.
+static ggml_sycl_graph * ggml_sycl_graph_variant(ggml_backend_sycl_context * ctx, ggml_cgraph * cgraph) {
+    const int64_t now = ggml_time_us();
+    const int64_t timeout = g_ggml_sycl_graph_eviction_timeout * 1'000'000LL;
+    if (now - ctx->last_graph_eviction_sweep >= timeout / 2) {
+        ctx->last_graph_eviction_sweep = now;
+        for (auto it = ctx->sycl_graph_variants.begin(); it != ctx->sycl_graph_variants.end(); ) {
+            auto & variants = it->second;
+            variants.erase(std::remove_if(variants.begin(), variants.end(), [now, timeout](const auto & graph) {
+                return now - graph->last_used_time >= timeout;
+            }), variants.end());
+            if (variants.empty()) {
+                it = ctx->sycl_graph_variants.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    auto & variants = ctx->sycl_graph_variants[ggml_sycl_graph_get_key(cgraph)];
+    ggml_sycl_graph * selected = nullptr;
+    for (auto & variant : variants) {
+        if (!ggml_sycl_graph_update_required(variant.get(), cgraph, true)) {
+            selected = variant.get();
+            break;
+        }
+    }
+    if (!selected) {
+        if (variants.size() >= static_cast<size_t>(g_ggml_sycl_graph_variants)) {
+            auto lru = std::min_element(variants.begin(), variants.end(), [](const auto & a, const auto & b) {
+                return a->variant_use < b->variant_use;
+            });
+            variants.erase(lru);
+        }
+        variants.push_back(std::make_unique<ggml_sycl_graph>());
+        selected = variants.back().get();
+        // Save properties even for incompatible graphs, but retain the normal first warmup call.
+        ggml_sycl_graph_update_required(selected, cgraph);
+        selected->variant_fresh = true;
+    }
+    selected->last_used_time = now;
+    selected->variant_use = ++ctx->graph_variant_use_counter;
+    return selected;
+}
