# BOXP-554 lab only: the production image (by digest) with the lolice ConfigMaps mounted where the Pod has
# them. The bootstrap init container's script lays out /opt/data exactly as at a Pod start. Never pushed.
ARG BASE
FROM ${BASE}
USER root
COPY bootstrap/ /bootstrap/
COPY bootstrap-plugins/ /bootstrap-plugins/
COPY lab/ stub.bb home.bb tick.sh /lab/
# /opt/data is a declared volume: only COPY reaches it. Ownership is fixed by the init script.
COPY data/ /opt/data/
RUN mkdir -p /lab/logs /lab/tb /lab/vault/Tickets /lab/vault/Projects /lab/vault/Boards /home/boxp/Documents/obsidian-headless \
    && : > "/lab/vault/Boards/Task Board.md" && printf 'home-token\n' > /lab/token \
    && ln -s /lab/vault /home/boxp/Documents/obsidian-headless/BOXP && chmod -R a+rwX /lab && chmod 0755 /lab/*.sh
# The BOXP_NOTIFY_* values are the production Deployment env (lolice argoproj/hermes-agent/deployment.yaml); the
# vault is the production default path. Only the Telegram API base (loopback stub) and timing are lab values.
ENV HOME=/opt/data HERMES_UID=1000 HERMES_GID=10000 WEBHOOK_ENABLED=true WEBHOOK_SECRET=lab-secret \
    BOXP_NOTIFY_ENABLED=1 BOXP_NOTIFY_TELEGRAM_MODE=fallback BOXP_NOTIFY_TELEGRAM_MODE_ALERTMANAGER=both \
    BOXP_NOTIFY_TELEGRAM_MODE_CRON=both \
    BOXP_NOTIFY_TELEGRAM_API_BASE=http://127.0.0.1:18080 BOXP_NOTIFY_RECOVERY_SECONDS=10 LAB_LOG_DIR=/lab/logs
