// The page itself is never committed: scripts/deploy.sh fills public/ at deploy time.
// ACCESS_AUD comes from the live Access application at deploy time (see scripts/deploy.sh).
{
  "name": "lolice-architecture",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lolice-architecture.b0xp.io/*", "zone_name": "b0xp.io" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://boxp.cloudflareaccess.com"
  }
}
