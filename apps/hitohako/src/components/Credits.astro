---
import Window from './Window.astro';
---

<section id="credits" class="scroll-mt-28 px-2 sm:px-4 py-10 pb-20 max-w-5xl mx-auto space-y-8">
  <h2 class="title-logo text-2xl sm:text-3xl text-center">
    クレジット <span class="text-gold text-base sm:text-lg">CREDITS</span>
  </h2>

  <Window tab="STAFF" paper>
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm sm:text-base">
      <dt class="tracking-widest text-xs sm:text-sm pt-1">CHARACTER</dt>
      <dd>ひとはこ（VRoid の力で生まれました）</dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">ICON / HERO IMAGE</dt>
      <dd>nagaren さん（YouTube チャンネルのアイコン・ヒーローイメージ）</dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">PIXEL ART</dt>
      <dd>BOXP（Gemini 画像生成 + proper-pixel-art で制作）</dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">FONT</dt>
      <dd>
        <a class="pixel-link" href="https://fonts.google.com/specimen/DotGothic16" target="_blank" rel="noopener noreferrer"
          >DotGothic16</a
        >（fontopo / SIL Open Font License 1.1）
      </dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">BUILT WITH</dt>
      <dd>Astro + Tailwind CSS / Cloudflare Pages</dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">SOURCE</dt>
      <dd>
        <a class="pixel-link" href="https://github.com/boxp/hitohako-site" target="_blank" rel="noopener noreferrer"
          >github.com/boxp/hitohako-site</a
        >
      </dd>

      <dt class="tracking-widest text-xs sm:text-sm pt-1">SPECIAL THANKS</dt>
      <dd>ひとはこさんファンクラブのみなさん</dd>
    </dl>
  </Window>

  <p class="text-center text-xs text-paper/50 tracking-widest">
    THANK YOU FOR PLAYING ⛩ <a href="#title" class="pixel-link">▲ TOP</a>
  </p>
</section>
