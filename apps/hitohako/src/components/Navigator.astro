---
/**
 * コハコ.exe navigator window (Mega Man Battle Network style).
 * Text is rendered statically: no typewriter effect or blinking caret,
 * so the window never flickers regardless of motion preferences.
 */
import Window from './Window.astro';
import Illust from './Illust.astro';

interface Props {
  lines: string[];
  id?: string;
}

const { lines, id } = Astro.props;
---

<Window id={id} tab="NAVI: コハコ.exe" cursor>
  <div class="flex gap-4 items-start">
    <Illust
      src="/illust/kohako-face.png"
      alt="コハコ.exe の顔グラフィック"
      class="shrink-0 border-2 border-cyan bg-ink"
    />
    <p class="text-cyan text-sm sm:text-base leading-relaxed">
      {lines.join(' ')}
    </p>
  </div>
</Window>
