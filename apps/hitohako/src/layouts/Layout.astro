---
import "../styles/global.css";
import { heroImage, HERO_SIZES } from "../lib/hero";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "ひとはこ | 変身ヒロインVTuber",
  description = "ひとはこ（変身ヒロインVTuber）の公式サイト。シューティングゲームの1CC配信を中心に、プロフィール・配信アーカイブ・公式リンクをまとめています。",
} = Astro.props;
const siteUrl = Astro.site?.toString() ?? "https://hitohako-stage.b0xp.io/";
const isStage = import.meta.env.PUBLIC_SITE_STAGE !== "false";
const ogImage = new URL("/illust/hitohako-profile-570eabbe64.jpg", siteUrl).toString();
const hero = heroImage();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdeef1" />
    {isStage && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="image"
      imagesrcset={hero.srcset}
      imagesizes={HERO_SIZES}
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      本文へスキップ
    </a>
    {isStage && (
      <div class="stage-banner" role="status">
        STAGE 環境（hitohako-stage.b0xp.io）- 公開前の確認用ページです
      </div>
    )}
    <slot />
  </body>
</html>
