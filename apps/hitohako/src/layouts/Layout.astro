---
import '../styles/global.css';
import { heroImage } from '../lib/hero';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ひとはこ | 変身ヒロインVTuber',
  description =
    'ひとはこさん（変身ヒロインVTuber）のポートフォリオサイト。プロフィール・活動・配信アーカイブ・リンク・仲間。和風 × 90年代レトロゲーム風。',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://hitohako-stage.b0xp.io/';
// PUBLIC_SITE_STAGE is set by the deploy workflow. Anything other than the
// explicit string 'false' is treated as stage (noindex + STAGE banner).
const isStage = import.meta.env.PUBLIC_SITE_STAGE !== 'false';
const ogImage = new URL('/illust/hitohako-face.png', siteUrl).toString();
// Same content-hashed revision as the <picture> in TitleScreen.
const hero = heroImage();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a0b2e" />
    {isStage && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="image"
      imagesrcset={hero.srcset}
      imagesizes="100vw"
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#menu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-gold focus:text-ink focus:px-3 focus:py-1"
      >メニューへスキップ</a
    >
    {
      isStage && (
        <div
          class="stage-banner fixed top-0 left-0 z-50 w-full bg-gold text-ink text-center text-xs tracking-widest py-1 border-b-2 border-ink"
          role="status"
        >
          STAGE 環境（hitohako-stage.b0xp.io）- 公開前の確認用ページです
        </div>
      )
    }
    <slot />
  </body>
</html>
