---
interface Props {
  href: string;
  class?: string;
  label?: string;
}
const { href, class: className = '', label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class:list={['underline decoration-line underline-offset-4 transition hover:text-accent hover:decoration-accent', className]}
>
  <slot />
</a>
