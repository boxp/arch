---
import Layout from '../layouts/Layout.astro';
import type { Diagram } from '../lib/diagrams';

interface Props {
  diagram: Diagram;
}

const { diagram } = Astro.props;
const isPublic = diagram.access === 'public';
---

<Layout title={`${diagram.title} — BOXP`} description={diagram.lead}>
  <header class="border-b border-line">
    <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3" aria-label="サイト内ナビゲーション">
      <a href="/" class="font-mono text-sm font-semibold text-accent">b0xp.io</a>
      <a href="/#infrastructure" class="text-sm text-muted hover:text-fg">Infrastructure へ戻る</a>
    </nav>
  </header>
  <main id="main" class="mx-auto max-w-3xl px-5 py-16">
    <p class="font-mono text-sm text-accent">Infrastructure</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">{diagram.title}</h1>
    <p class="mt-4">
      {isPublic ? (
        <span class="inline-block rounded border border-accent/50 px-2 py-0.5 text-xs text-accent">公開</span>
      ) : (
        <span class="inline-block rounded border border-amber-400/50 px-2 py-0.5 text-xs text-amber-200">本人限定・未公開</span>
      )}
    </p>
    <p class="mt-5 text-lg leading-relaxed text-fg/90">{diagram.lead}</p>
    <ul class="mt-6 list-disc space-y-2 pl-5 text-sm leading-relaxed">
      {diagram.points.map((point) => <li>{point}</li>)}
    </ul>
    <p class="mt-8">
      <a
        href={diagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded border border-accent px-4 py-2 text-sm font-semibold text-accent transition hover:bg-accent hover:text-ink"
      >
        図を開く
      </a>
    </p>
    {!isPublic && (
      <p class="mt-6 rounded-lg border border-dashed border-line p-4 text-sm leading-relaxed text-muted">
        内容の確認が済むまで、図は本人のログインでだけ開けます。このページも stage にだけあります。
      </p>
    )}
    <slot />
  </main>
</Layout>
